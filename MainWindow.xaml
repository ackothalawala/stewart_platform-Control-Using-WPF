<Window x:Class="stewart_platform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Stewart Platform V2 (No Yaw)" Height="650" Width="1100" Background="#F0F0F0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <GroupBox Header="Hardware" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <ComboBox x:Name="PortSelector" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnConnect" Content="Connect" Width="100" Click="BtnConnect_Click"/>
                            <Button x:Name="BtnReset" Content="Reset" Width="100" Margin="10,0,0,0" Click="BtnReset_Click" Background="#FFDDDD"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtStatus" Text="Disconnected" FontWeight="Bold" Margin="0,5,0,0" Foreground="Red"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Position (mm)" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="X Trans:" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="InpPosX" Text="0" Grid.Column="1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="Set" Grid.Column="2" Click="BtnSetPos_Click" Tag="X"/>
                        </Grid>
                        <Slider x:Name="SldPosX" Minimum="-35" Maximum="35" ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Y Trans:" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="InpPosY" Text="0" Grid.Column="1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="Set" Grid.Column="2" Click="BtnSetPos_Click" Tag="Y"/>
                        </Grid>
                        <Slider x:Name="SldPosY" Minimum="-35" Maximum="35" ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Z Trans:" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="InpPosZ" Text="0" Grid.Column="1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="Set" Grid.Column="2" Click="BtnSetPos_Click" Tag="Z"/>
                        </Grid>
                        <Slider x:Name="SldPosZ" Minimum="-35" Maximum="35" ValueChanged="Slider_ValueChanged" Margin="0,0,0,5"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Rotation (Deg)" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Roll (X):" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="InpRotX" Text="0" Grid.Column="1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="Set" Grid.Column="2" Click="BtnSetRot_Click" Tag="X"/>
                        </Grid>
                        <Slider x:Name="SldRotX" Minimum="-12" Maximum="12" ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Pitch (Y):" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="InpRotY" Text="0" Grid.Column="1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="Set" Grid.Column="2" Click="BtnSetRot_Click" Tag="Y"/>
                        </Grid>
                        <Slider x:Name="SldRotY" Minimum="-12" Maximum="12" ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Real-time Sensor Feedback (MPU6050)" Margin="0,0,0,10" Padding="5" BorderBrush="Blue">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Label Content="Roll" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSensorRoll" Text="0.0°" FontSize="16" Foreground="Blue" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Label Content="Pitch" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSensorPitch" Text="0.0°" FontSize="16" Foreground="Blue" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Label Content="Temp" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSensorTemp" Text="0.0°C" FontSize="16" Foreground="Red" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Servo Data" Padding="5">
                    <StackPanel>
                        <TextBlock x:Name="TxtServo0" Text="S0: 0.00"/>
                        <TextBlock x:Name="TxtServo1" Text="S1: 0.00"/>
                        <TextBlock x:Name="TxtServo2" Text="S2: 0.00"/>
                        <TextBlock x:Name="TxtServo3" Text="S3: 0.00"/>
                        <TextBlock x:Name="TxtServo4" Text="S4: 0.00"/>
                        <TextBlock x:Name="TxtServo5" Text="S5: 0.00"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <helix:HelixViewport3D Grid.Column="1" ZoomExtentsWhenLoaded="True" Background="#333">
            <helix:SunLight/>
            <helix:GridLinesVisual3D Width="600" Length="600" MajorDistance="50" MinorDistance="10" Thickness="0.5" Fill="#555"/>
            <helix:TubeVisual3D x:Name="VisBase" Diameter="5" Fill="LightGreen"/>
            <helix:TubeVisual3D x:Name="VisPlatform" Diameter="5" Fill="LightBlue"/>

            <helix:TubeVisual3D x:Name="VisHorn0" Diameter="2" Fill="Red"/>
            <helix:TubeVisual3D x:Name="VisHorn1" Diameter="2" Fill="Red"/>
            <helix:TubeVisual3D x:Name="VisHorn2" Diameter="2" Fill="Red"/>
            <helix:TubeVisual3D x:Name="VisHorn3" Diameter="2" Fill="Red"/>
            <helix:TubeVisual3D x:Name="VisHorn4" Diameter="2" Fill="Red"/>
            <helix:TubeVisual3D x:Name="VisHorn5" Diameter="2" Fill="Red"/>

            <helix:TubeVisual3D x:Name="VisRod0" Diameter="1.5" Fill="White"/>
            <helix:TubeVisual3D x:Name="VisRod1" Diameter="1.5" Fill="White"/>
            <helix:TubeVisual3D x:Name="VisRod2" Diameter="1.5" Fill="White"/>
            <helix:TubeVisual3D x:Name="VisRod3" Diameter="1.5" Fill="White"/>
            <helix:TubeVisual3D x:Name="VisRod4" Diameter="1.5" Fill="White"/>
            <helix:TubeVisual3D x:Name="VisRod5" Diameter="1.5" Fill="White"/>
        </helix:HelixViewport3D>
    </Grid>
</Window>